{
  "name": "wcl2note-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-functions.mjs && node scripts/smoke-functions.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src server tests/unit tests/e2e scripts/*.mjs *.json *.ts *.js docs/*.md README.md"
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.7",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "esbuild": "0.25.5",
    "eslint": "9.28.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.0",
    "vite": "6.3.5",
    "vitest": "3.2.3"
  }
}
